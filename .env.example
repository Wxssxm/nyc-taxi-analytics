# NYC Taxi Analytics — environment configuration
# Copy this to .env and adjust as needed. Never commit .env.

# Path where downloaded parquet files are stored (relative to repo root)
DATA_DIR=data/raw

# Path for the DuckDB database file
DUCKDB_PATH=data/nyc_taxi.duckdb

# Default month range for downloads, inclusive (YYYY-MM)
DOWNLOAD_START_MONTH=2024-01
DOWNLOAD_END_MONTH=2024-03

# Taxi types to include — comma-separated. Options: yellow, green, fhv
TAXI_TYPES=yellow

# HTTP timeout in seconds for parquet downloads
HTTP_TIMEOUT=300

# Logging level — DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
